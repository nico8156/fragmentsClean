{
  "openapi": "3.1.0",
  "info": { "title": "Fragments Studio API", "version": "1.0.0", "description": "Authenticated Studio transport contract." },
  "servers": [{ "url": "https://fragments-staging.anchor-event.fr" }],
  "security": [{ "studioOAuth": [] }],
  "paths": {
    "/api/admin/coffees": {
      "get": { "operationId": "listAdminCoffees", "responses": { "200": { "description": "Authoritative admin coffee projection", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/AdminCoffee" } } } } } } }
    },
    "/api/admin/coffees/{coffeeId}/publish": {
      "post": { "operationId": "publishCoffee", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }], "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } } }
    },
    "/api/admin/coffees/{coffeeId}/operations": {
      "get": { "operationId": "listCoffeeOperations", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 } }], "responses": { "200": { "description": "Durable Studio operation journal", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CoffeeOperation" } } } } } } }
    },
    "/api/admin/coffees/{coffeeId}/unpublish": {
      "post": { "operationId": "unpublishCoffee", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }], "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } } }
    },
    "/api/admin/coffees/{coffeeId}/details": {
      "put": {
        "operationId": "editCoffeeDetails",
        "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EditCoffeeDetails" } } } },
        "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } }
      }
    },
    "/api/admin/coffees/{coffeeId}/opening-hours": {
      "put": {
        "operationId": "updateCoffeeOpeningHours",
        "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCoffeeOpeningHours" } } } },
        "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } }
      }
    },
    "/api/admin/coffees/{coffeeId}": {
      "delete": { "operationId": "archiveCoffee", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }], "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } } }
    },
    "/api/admin/coffees/{coffeeId}/permanent": {
      "delete": { "operationId": "permanentlyDeleteCoffee", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }], "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } } }
    },
    "/api/admin/coffees/{coffeeId}/photos": {
      "post": {
        "operationId": "addCoffeePhoto",
        "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["photo"], "properties": { "photo": { "type": "string", "format": "binary" } } } } } },
        "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } }
      }
    },
    "/api/admin/coffees/{coffeeId}/photos/{photoId}": {
      "delete": {
        "operationId": "deleteCoffeePhoto",
        "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }, { "name": "photoId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } }
      }
    },
    "/api/admin/coffees/{coffeeId}/photos/order": {
      "put": {
        "operationId": "arrangeCoffeePhotos", "parameters": [{ "$ref": "#/components/parameters/CoffeeId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArrangeCoffeePhotos" } } } },
        "responses": { "202": { "$ref": "#/components/responses/CommandAccepted" } }
      }
    },
    "/api/admin/editorial/topic-candidates": {
      "get": { "operationId": "listEditorialTopicCandidates", "responses": { "200": { "description": "Editorial topic candidates", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TopicCandidate" } } } } } } }
    },
    "/api/admin/editorial/topic-candidates/{candidateId}/start-authoring": {
      "post": { "operationId": "startArticleAuthoringFromTopic", "parameters": [{ "name": "candidateId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "202": { "description": "Article authoring accepted" } } }
    },
    "/api/admin/editorial/sources/analysis": {
      "post": { "operationId": "analyzePendingEditorialSignals", "responses": { "204": { "description": "Pending editorial signals were analysed" } } }
    },
    "/api/admin/editorial/calendar": {
      "get": { "operationId": "getEditorialCalendarMonth", "parameters": [{ "name": "month", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } }], "responses": { "200": { "description": "Monthly editorial schedule", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EditorialCalendarItem" } } } } } } },
      "post": { "operationId": "scheduleEditorialOperation", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScheduleEditorialOperation" } } } }, "responses": { "202": { "description": "Durable schedule accepted" } } }
    },
    "/api/admin/editorial/calendar/{scheduleId}/cancel": {
      "post": { "operationId": "cancelEditorialOperation", "parameters": [{ "name": "scheduleId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "202": { "description": "Schedule cancelled" } } }
    },
    "/api/admin/commands/{commandId}": {
      "get": {
        "operationId": "getAdminCommandStatus",
        "parameters": [{ "name": "commandId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Canonical command outcome", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandStatus" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": { "studioOAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": { "CoffeeId": { "name": "coffeeId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "responses": { "CommandAccepted": { "description": "Command accepted; projection may still be stale", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandAccepted" } } } } },
    "schemas": {
      "CommandAccepted": {
        "type": "object", "additionalProperties": false, "required": ["commandId", "status"],
        "properties": { "commandId": { "type": "string", "format": "uuid" }, "status": { "type": "string", "const": "PENDING" } }
      },
      "CommandStatus": {
        "type": "object", "additionalProperties": false, "required": ["commandId", "status"],
        "properties": { "commandId": { "type": "string", "format": "uuid" }, "status": { "type": "string", "enum": ["PENDING", "APPLIED", "REJECTED"] }, "reason": { "type": ["string", "null"] } }
      },
      "TopicCandidate": {
        "type": "object", "additionalProperties": false, "required": ["id", "subject", "suggestedAngle", "signalIds", "status"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "subject": { "type": "string" }, "suggestedAngle": { "type": "string" }, "signalIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }, "status": { "type": "string", "enum": ["DETECTED", "RETAINED", "DEFERRED", "IGNORED"] } }
      },
      "ScheduleEditorialOperation": {
        "type": "object", "additionalProperties": false, "required": ["articleId", "operation", "dueAt"],
        "properties": { "articleId": { "type": "string", "format": "uuid" }, "revisionId": { "type": ["string", "null"], "format": "uuid" }, "operation": { "type": "string", "enum": ["PUBLISH", "ARCHIVE"] }, "dueAt": { "type": "string", "format": "date-time" } }
      },
      "EditorialCalendarItem": {
        "type": "object", "additionalProperties": false, "required": ["scheduleId", "articleId", "operation", "dueAt", "status"],
        "properties": { "scheduleId": { "type": "string", "format": "uuid" }, "articleId": { "type": "string", "format": "uuid" }, "revisionId": { "type": ["string", "null"], "format": "uuid" }, "operation": { "type": "string", "enum": ["PUBLISH", "ARCHIVE"] }, "dueAt": { "type": "string", "format": "date-time" }, "status": { "type": "string", "enum": ["SCHEDULED", "CLAIMED", "DISPATCHED", "COMPLETED", "REJECTED", "CANCELLED"] }, "rejectionReason": { "type": ["string", "null"] } }
      },
      "AdminCoffee": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "location", "address", "tags", "publicationStatus", "version", "updatedAt", "photos", "openingHours"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "googleId": { "type": ["string", "null"] }, "name": { "type": "string", "minLength": 1 },
          "location": { "$ref": "#/components/schemas/Location" }, "address": { "$ref": "#/components/schemas/Address" },
          "phoneNumber": { "type": ["string", "null"] }, "website": { "type": ["string", "null"], "format": "uri" },
          "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "publicationStatus": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
          "version": { "type": "integer", "format": "int64", "minimum": 0 }, "updatedAt": { "type": "string", "format": "date-time" },
          "photos": { "type": "array", "items": { "$ref": "#/components/schemas/CoffeePhoto" } },
          "openingHours": { "type": "array", "items": { "$ref": "#/components/schemas/CoffeeOpeningHours" } }
        }
      },
      "EditCoffeeDetails": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "latitude", "longitude", "tags"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "addressLine1": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] },
          "postalCode": { "type": ["string", "null"] }, "country": { "type": ["string", "null"], "maxLength": 3 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "phoneNumber": { "type": ["string", "null"] }, "website": { "type": ["string", "null"], "format": "uri" },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      },
      "ArrangeCoffeePhotos": {
        "type": "object", "additionalProperties": false, "required": ["orderedPhotoIds", "coverPhotoId"],
        "properties": {
          "orderedPhotoIds": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
          "coverPhotoId": { "type": "string", "format": "uuid" }
        }
      },
      "UpdateCoffeeOpeningHours": {
        "type": "object", "additionalProperties": false, "required": ["schedules"],
        "properties": { "schedules": { "type": "array", "maxItems": 7, "items": { "$ref": "#/components/schemas/DaySchedule" } } }
      },
      "DaySchedule": {
        "type": "object", "additionalProperties": false, "required": ["dayCode", "windows"],
        "properties": { "dayCode": { "type": "integer", "minimum": 0, "maximum": 6 }, "windows": { "type": "array", "items": { "$ref": "#/components/schemas/TimeWindow" } } }
      },
      "TimeWindow": {
        "type": "object", "additionalProperties": false, "required": ["startMinute", "endMinute"],
        "properties": { "startMinute": { "type": "integer", "minimum": 0, "maximum": 1439 }, "endMinute": { "type": "integer", "minimum": 1, "maximum": 1440 } }
      },
      "Location": { "type": "object", "additionalProperties": false, "required": ["lat", "lon"], "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } } },
      "Address": { "type": "object", "additionalProperties": false, "properties": { "line1": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] }, "postalCode": { "type": ["string", "null"] }, "country": { "type": ["string", "null"] } } },
      "CoffeePhoto": { "type": "object", "additionalProperties": false, "required": ["id", "photoUri", "cover", "sortOrder"], "properties": { "id": { "type": "string", "format": "uuid" }, "photoUri": { "type": "string", "format": "uri" }, "cover": { "type": "boolean" }, "sortOrder": { "type": "integer", "minimum": 0 } } },
      "CoffeeOpeningHours": { "type": "object", "additionalProperties": false, "required": ["id", "weekdayDescription"], "properties": { "id": { "type": "string", "format": "uuid" }, "weekdayDescription": { "type": "string" } } }
      ,"CoffeeOperation": { "type": "object", "additionalProperties": false, "required": ["id", "actorUserId", "action", "outcome", "occurredAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "actorUserId": { "type": "string", "format": "uuid" }, "action": { "type": "string" }, "commandId": { "type": ["string", "null"], "format": "uuid" }, "outcome": { "type": "string" }, "reason": { "type": ["string", "null"] }, "occurredAt": { "type": "string", "format": "date-time" } } }
    }
  }
}
