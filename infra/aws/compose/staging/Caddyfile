{$APP_DOMAIN} {
    @notSse {
        not path /api/sync/events /api/admin/sync/events
    }
    encode @notSse gzip

    @sse path /api/sync/events /api/admin/sync/events
    handle @sse {
        reverse_proxy backend:8080 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy backend:8080
    }
}
