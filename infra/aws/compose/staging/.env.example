########################################
# Application
########################################

APP_NAME=fragments
APP_ENV=staging
APP_DOMAIN=fragments-staging.anchor-event.fr
SPRING_PROFILES_ACTIVE=prod

########################################
# Container
########################################

BACKEND_IMAGE=<ecr-repository-uri>:<image-tag>
COMPOSE_PROFILES=https

########################################
# PostgreSQL
########################################

POSTGRES_DB=fragmentsclean
POSTGRES_USER=fragments
POSTGRES_PASSWORD=<secret>

########################################
# Authentication
########################################

AUTH_JWT_SECRET=<secret>
AUTH_JWT_ISSUER=https://auth.fragments

########################################
# Google OAuth
########################################

GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<secret>
GOOGLE_OAUTH_REDIRECT_URI=https://fragments-staging.anchor-event.fr/login/oauth2/code/google

########################################
# Google Places
########################################

GOOGLE_PLACES_API_KEY=<secret>

########################################
# OpenAI
########################################

OPENAI_API_KEY=<secret-or-empty>
OPENAI_PROJECT_ID=<project-id-or-empty>

########################################
# Ticket Verification
########################################

TICKETVERIFY_BINARY_PATH=/app/bin/ticketverify
TICKETVERIFY_TIMEOUT_MS=1500

########################################
# AWS
########################################

AWS_REGION=eu-west-3

########################################
# Messaging
########################################

APP_MESSAGING_KAFKA_ENABLED=false
APP_MESSAGING_LOCAL_EVENT_BUS_ENABLED=false
APP_MESSAGING_SQS_ENABLED=true

SQS_ARTICLES_EVENTS_URL=<sqs-queue-url>
SQS_AUTH_USERS_EVENTS_URL=<sqs-queue-url>
SQS_APP_USERS_EVENTS_URL=<sqs-queue-url>
SQS_COFFEES_EVENTS_URL=<sqs-queue-url>
SQS_DOMAIN_EVENTS_URL=<sqs-queue-url>
SQS_TICKET_EVENTS_URL=<sqs-queue-url>
SQS_TICKET_VERIFICATION_REQUESTED_URL=<sqs-queue-url>
