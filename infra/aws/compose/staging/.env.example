BACKEND_IMAGE=000000000000.dkr.ecr.eu-west-3.amazonaws.com/fragments/staging/backend:manual
COMPOSE_PROFILES=https
APP_DOMAIN=api-staging.fragments.example

POSTGRES_USER=fragments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fragmentsclean

SPRING_PROFILES_ACTIVE=prod
AUTH_JWT_SECRET=change-me-minimum-32-characters
AUTH_JWT_ISSUER=https://auth.fragments
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.fragments.example/auth/google/callback
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
TICKETVERIFY_BINARY_PATH=/app/bin/ticketverify
TICKETVERIFY_TIMEOUT_MS=1500

AWS_REGION=eu-west-3
APP_MESSAGING_KAFKA_ENABLED=false
APP_MESSAGING_LOCAL_EVENT_BUS_ENABLED=false
APP_MESSAGING_SQS_ENABLED=true
SQS_ARTICLES_EVENTS_URL=
SQS_AUTH_USERS_EVENTS_URL=
SQS_APP_USERS_EVENTS_URL=
SQS_COFFEES_EVENTS_URL=
SQS_DOMAIN_EVENTS_URL=
SQS_TICKET_EVENTS_URL=
SQS_TICKET_VERIFICATION_REQUESTED_URL=
