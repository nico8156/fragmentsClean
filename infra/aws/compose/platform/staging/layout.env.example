# Non-secret host layout for the shared staging runtime.
# This file is documentation/configuration input, not a secret store.

PLATFORM_ROOT=/srv/platform
ANCHOR_RUNTIME_ROOT=/srv/anchor/staging
FRAGMENTS_RUNTIME_ROOT=/srv/fragments/staging

ANCHOR_POSTGRES_DATA_ROOT=/srv/anchor-postgres/postgres-data
FRAGMENTS_POSTGRES_DATA_ROOT=/srv/fragments-postgres/postgres-data
FRAGMENTS_COFFEE_PHOTOS_ROOT=/srv/fragments/staging/coffee-photos

ANCHOR_EDGE_NETWORK=anchor-staging-edge
FRAGMENTS_EDGE_NETWORK=fragments-staging-edge
