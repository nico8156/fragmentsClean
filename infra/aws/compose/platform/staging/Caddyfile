{$FRAGMENTS_API_DOMAIN} {
	@fragmentsHome path /
	handle @fragmentsHome {
		root * /data/fragments-public
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		file_server
	}

	handle_path /legal/* {
		root * /data/fragments-public
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		file_server
	}

	@sse path /api/sync/events /api/admin/sync/events
	handle @sse {
		reverse_proxy fragments-backend:8080 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy fragments-backend:8080
	}
}

# Public presentation only. The API and TestFlight legal URLs remain on staging.
fragments.anchor-event.fr {
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	@publicHome path /
	handle @publicHome {
		root * /data/fragments-site/current
		file_server
	}

	@publicLegal path /legal/site.css /legal/tech.html /legal/confidentialite.html /legal/conditions.html /legal/mentions-legales.html
	handle @publicLegal {
		uri strip_prefix /legal
		root * /data/fragments-site/current
		file_server
	}

	handle {
		respond 404
	}
}
