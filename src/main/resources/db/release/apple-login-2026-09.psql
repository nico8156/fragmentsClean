-- Separate additive release: previously applied manifests remain immutable.
\set ON_ERROR_STOP on
\if :{?release_checksum}
\else
  SELECT 1 / 0 AS missing_release_checksum;
\endif
\if :{?source_revision}
\else
  SELECT 1 / 0 AS missing_source_revision;
\endif
SELECT :'release_checksum' ~ '^[0-9a-f]{64}$' AND :'source_revision' ~ '^[0-9a-f]{40}$' AS valid_metadata \gset
\if :valid_metadata
\else
  SELECT 1 / 0 AS invalid_migration_metadata;
\endif
BEGIN;
SET LOCAL search_path TO public, pg_catalog;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '5min';
SELECT pg_advisory_xact_lock(20260914, 1);
SELECT EXISTS (SELECT 1 FROM release_schema_history WHERE version='app-store-2026-09') AS valid_baseline \gset
\if :valid_baseline
\else
  SELECT 1 / 0 AS missing_app_store_baseline;
\endif
SELECT EXISTS (SELECT 1 FROM release_schema_history WHERE version='apple-login-2026-09') AS already_applied,
       NOT EXISTS (SELECT 1 FROM release_schema_history WHERE version='apple-login-2026-09'
                   AND checksum <> :'release_checksum') AS checksum_matches \gset
\if :checksum_matches
\else
  SELECT 1 / 0 AS migration_checksum_mismatch;
\endif
\if :already_applied
  \echo Apple login migration already applied
\else
\ir 2026-09-14-apple-optional-email.sql
INSERT INTO release_schema_history(version,checksum,source_revision)
VALUES ('apple-login-2026-09', :'release_checksum', :'source_revision');
\endif
COMMIT;
